# Clinical Intelligence System - Environment Configuration
# Copy to .env and fill in your values
# NEVER commit the real .env file

# --- OpenRouter (LLM generation; no local LLM is used) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_MAX_TOKENS=2048
OPENROUTER_TEMPERATURE=0.0
OPENROUTER_SEED=42

# --- Data source: Europe PMC REST API ---
# The local corpus (data/corpus.jsonl) is the PRIMARY source and needs no network.
# These settings are only used by `python scripts/download_data.py --refresh`.
# Europe PMC replaced NCBI eutils, which is rate-limited and unreliable.
EUROPE_PMC_BASE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest
EUROPE_PMC_SEARCH_PATH=search
# Contact address Europe PMC uses for polite access; set to your own address.
EUROPE_PMC_EMAIL=your_email@example.com
EUROPE_PMC_PAGE_SIZE=100
EUROPE_PMC_MAX_RETRIES=3
EUROPE_PMC_TIMEOUT=30
# Seconds between requests (be polite; do not set below 1.0).
EUROPE_PMC_REQUEST_DELAY=1.0

# Deprecated: NCBI eutils is no longer used. Kept only for backwards compatibility.
ENTREZ_EMAIL=dev@example.com

# App settings
APP_ENV=development
APP_DEBUG=True
APP_HOST=0.0.0.0
APP_PORT=8000

# RAG settings
RAG_K_RETRIEVE=20
RAG_K_RERANK=8

# Citation settings
CITATION_TOP_K=5
CITATION_MAX_EXCERPT_CHARS=900

# Privacy
ABSTAIN_CONFIDENCE_THRESHOLD=0.45
